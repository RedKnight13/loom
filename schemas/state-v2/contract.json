          "maximum": 9007199254740991
        },
        "start_ticks": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9-]{36}$"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "store_id",
        "sequence",
        "event_sequence",
        "last_digest",
        "entities",
        "operations",
        "events"
      ],
      "properties": {
        "schema": {
          "const": 2
        },
        "store_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-loom-maxUtf8Bytes": 128,
          "pattern": "^[^\u0000]+$",
          "description": "1\u2013128 UTF-8 bytes; NUL prohibited. Runtime canonical JSON rules also apply."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "last_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^git-blob-sha1-v1:[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "entities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "task": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "assignment": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "attempt": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "message": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "delivery": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "gate": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "operation": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "config": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "host": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            },
            "profile": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/entity"
              }
            }
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "maxItems": 4096,
          "minItems": 0
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "maxItems": 409600,
          "minItems": 0
        }
      }
    }
  }
}
