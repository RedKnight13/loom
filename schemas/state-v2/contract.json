    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/transaction"
    },
    {
      "$ref": "#/$defs/metadata"
    },
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/outcome"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/lock"
    }
  ],
  "$defs": {
